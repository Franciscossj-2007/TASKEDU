PORT=3000
NODE_ENV=development

# Conexion a PostgreSQL (pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=da762331
DB_NAME=gestion_tareas_academicas

# Clave para firmar los tokens JWT (cambiar por un secreto seguro)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO
JWT_EXPIRES_IN=2h

# Origen del frontend autorizado por CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Asistente academico con Gemini (la clave solo se usa en el backend)
GEMINI_API_KEY=CAMBIAR_POR_TU_CLAVE_DE_GEMINI
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcionales: tiempo de espera por intento (acotado a 5-20 s; maximo 1 reintento)
GEMINI_TIMEOUT_MS=15000
IA_MAX_TAREAS=60
IA_MAX_REQUESTS_PER_MINUTE=10
IA_MAX_REQUESTS_PER_DAY=60
IA_MAX_TOKENS_ORGANIZADOR=1400
IA_MAX_TOKENS_PREGUNTAS=700
IA_MAX_TOKENS_RESPUESTA=800
IA_MAX_TOKENS_DUDA=700
